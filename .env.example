# Neon Postgres — required. The board and rate limiting both live here.
DATABASE_URL="postgresql://user:password@host.neon.tech/loudlist?sslmode=require"

# Public origin. Used for share links and to reject cross-site claim POSTs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public contact shown in the footer and privacy page.
NEXT_PUBLIC_CONTACT_EMAIL="hello@nawazish.site"

# Moderation. Long random string; sent as "Authorization: Bearer <token>" to /api/admin/claims.
LOUDLIST_ADMIN_TOKEN=""

# Optional. POST JSON here when someone reports a listing (Slack/Discord-compatible).
# LOUDLIST_REPORT_WEBHOOK_URL=""

# Optional ceiling on a single claim, in cents. Defaults to 500000 ($5,000).
# The $1 floor is hardcoded — it is not an env var.
# This ceiling matters: it bounds how long a single huge claim can outrun the
# 24-hour decay, so raising it a lot makes the board stickier at the top.
# LOUDLIST_MAX_BID_CENTS="500000"
